{
  "name": "greenbox-sistem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3241",
    "build": "next build",
    "start": "next start -p 3241",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "seed:contoh": "tsx scripts/seed-contoh.ts",
    "impor:menu": "tsx scripts/impor-menu.ts",
    "impor:stok": "tsx scripts/impor-stok.ts",
    "impor:beli": "tsx scripts/impor-beli.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "e2e": "mkdir -p tests/hasil && bash tests/e2e/jalankan.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "jose": "^6.2.12",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "1.65.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
