  @@index([purchasePaymentId])
  @@map("purchase_payment_alloc")
}

// ===== Lokasi dan persediaan =====

model Branch {
  id            Int        @id @default(autoincrement())
  code          String     @unique
  name          String
  address       String     @default("")
  // tahap 6A: profil usaha (NPWP, telepon, logo struk) dan jejak ubah.
  npwp          String     @default("")
  phone         String     @default("")
  taxPct        Decimal    @default(0) @map("tax_pct") @db.Decimal(6, 3)
  servicePct    Decimal    @default(0) @map("service_pct") @db.Decimal(6, 3)
  receiptHeader String     @default("") @map("receipt_header")
  receiptFooter String     @default("") @map("receipt_footer")
  receiptLogo   String?    @map("receipt_logo")
  active        Boolean    @default(true)
  updatedBy     Int?       @map("updated_by")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  locations     Location[]

  @@map("branch")
}

model Location {
  id                   Int                @id @default(autoincrement())
  branchId             Int                @map("branch_id")
  branch               Branch             @relation(fields: [branchId], references: [id])
  // tahap 4A: kode tetap untuk lokasi bawaan dan impor (HO, OUTLET).
  code                 String             @unique
  name                 String
  kind                 String             @default("gudang")
  allowNegativeStock   Boolean            @default(false) @map("allow_negative_stock")
  active               Boolean            @default(true)
  transfersFrom        StockTransfer[]    @relation("PindahDari")
  transfersTo          StockTransfer[]    @relation("PindahKe")
  productionsMaterial  ProductionOrder[]  @relation("ProduksiLokasiBahan")
  productionsOutput    ProductionOrder[]  @relation("ProduksiLokasiHasil")
  quickProductionsFrom QuickProduction[]  @relation("ProduksiCepatDari")
  quickProductionsTo   QuickProduction[]  @relation("ProduksiCepatKe")
  appUsers             AppUser[]
  purchaseRequests     PurchaseRequest[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseReturns      PurchaseReturn[]
  directPurchases      DirectPurchase[]
  stockBalances        StockBalance[]
  stockLedgers         StockLedger[]
  stockAdjustments     StockAdjustment[]
  stockOpnames         StockOpname[]
  materialIssues       MaterialIssue[]
  productionResults    ProductionResult[]
  shifts               Shift[]
  salesOrders          SalesOrder[]
  salesInvoices        SalesInvoice[]
  salesReturns         SalesReturn[]
  fixedAssets          FixedAsset[]

  @@map("location")
}

model StockBalance {
  productId   Int      @map("product_id")
  product     Product  @relation(fields: [productId], references: [id])
  locationId  Int      @map("location_id")
  location    Location @relation(fields: [locationId], references: [id])
  qty         Decimal  @default(0) @db.Decimal(18, 3)
  reservedQty Decimal  @default(0) @map("reserved_qty") @db.Decimal(18, 3)
  // tahap 4A: nilai persediaan (rupiah bulat) dan harga rata-rata tertimbang per lokasi (KONTRAK 12).
  value       BigInt   @default(0)
  avgCost     Decimal  @default(0) @map("avg_cost") @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([productId, locationId])
  @@map("stock_balance")
}

model StockLedger {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  product      Product  @relation(fields: [productId], references: [id])
  locationId   Int      @map("location_id")
  location     Location @relation(fields: [locationId], references: [id])
  at           DateTime @default(now()) @db.Timestamptz(6)
  date         DateTime @db.Date
  qty          Decimal  @db.Decimal(18, 3)
  unitCost     Decimal  @map("unit_cost") @db.Decimal(18, 4)
  value        BigInt
  balanceQty   Decimal  @map("balance_qty") @db.Decimal(18, 3)
  avgCostAfter Decimal  @map("avg_cost_after") @db.Decimal(18, 4)
  // tahap 4A: saldo nilai sesudah gerak dan nomor dokumen asal untuk kartu stok.
  balanceValue BigInt   @default(0) @map("balance_value")
  // Koreksi nilai saat barang masuk menutup saldo nol atau minus (KONTRAK 11 butir 127). Sudah termasuk di value,
  // jadi nilai dokumen = value - revalue. Dijurnal ke HPP.
  revalue      BigInt   @default(0)
  docType      String   @map("doc_type")
  docId        Int      @map("doc_id")
  docNo        String   @default("") @map("doc_no")
  lineId       Int?     @map("line_id")
  isReversal   Boolean  @default(false) @map("is_reversal")
  createdBy    Int?     @map("created_by")

  @@index([productId, locationId, id])
  @@index([productId, locationId, at])
  @@index([docType, docId])
  @@map("stock_ledger")
}

model StockAdjustment {
  id                   Int                   @id @default(autoincrement())
  locationId           Int                   @map("location_id")
  location             Location              @relation(fields: [locationId], references: [id])
  no                   String                @unique
  date                 DateTime              @db.Date
  note                 String                @default("")
  status               DocStatus             @default(Draft)
  submittedBy          Int?                  @map("submitted_by")
  submittedAt          DateTime?             @map("submitted_at") @db.Timestamptz(6)
  approvedBy           Int?                  @map("approved_by")
  approvedAt           DateTime?             @map("approved_at") @db.Timestamptz(6)
  cancelledBy          Int?                  @map("cancelled_by")
  cancelledAt          DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  cancelReason         String?               @map("cancel_reason")
  postedBy             Int?                  @map("posted_by")
