// Skema admin Greenbox. Sumber: ERD rancangan (erd-data.mjs, entitas g: true) dan sistem/KONTRAK.md bagian 3.
// Model PascalCase dipetakan ke tabel snake_case, kolom camelCase ke snake_case.
// Uang BigInt rupiah bulat, qty Decimal(18,3), harga satuan per satuan dasar Decimal(18,4).
// Kolom *_by berisi app_user.id tanpa foreign key (KONTRAK 3.1).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocStatus {
  Draft
  Diajukan
  Disetujui
  Diposting
  Selesai
  Batal

  @@map("doc_status")
}

enum PayStatus {
  BelumBayar
  Sebagian
  Lunas

  @@map("pay_status")
}

enum Progress {
  Belum
  Sebagian
  Penuh

  @@map("progress")
}

enum ShiftStatus {
  Buka
  Tutup
  PerluPersetujuan

  @@map("shift_status")
}

enum SaleStatus {
  Selesai
  Void

  @@map("sale_status")
}

enum AccountKind {
  Aset
  Kewajiban
  Ekuitas
  Pendapatan
  HPP
  Beban

  @@map("account_kind")
}

enum PeriodStatus {
  Terbuka
  Ditutup

  @@map("period_status")
}

enum MatchStatus {
  BelumCocok
  Cocok

  @@map("match_status")
}

// ===== Pengguna, izin, audit =====

model AppUser {
  id             Int            @id @default(autoincrement())
  roleId         Int            @map("role_id")
  role           Role           @relation(fields: [roleId], references: [id])
  locationId     Int?           @map("location_id")
  location       Location?      @relation(fields: [locationId], references: [id])
  name           String
  username       String         @unique
  passwordHash   String         @map("password_hash")
  pinHash        String?        @map("pin_hash")
  active         Boolean        @default(true)
  lastLoginAt    DateTime?      @map("last_login_at") @db.Timestamptz(6)
  createdBy      Int?           @map("created_by")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy      Int?           @map("updated_by")
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions       UserSession[]
  auditLogs      AuditLog[]
  shifts         Shift[]        @relation("ShiftKasir")
  shiftsApproved Shift[]        @relation("ShiftPenyetuju")
  periodsClosed  FiscalPeriod[]

  @@index([roleId])
  @@map("app_user")
}

model Role {
  id          Int                 @id @default(autoincrement())
  code        String              @unique
  name        String
  isSystem    Boolean             @default(false) @map("is_system")
  active      Boolean             @default(true)
  createdBy   Int?                @map("created_by")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy   Int?                @map("updated_by")
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  users       AppUser[]
  permissions RolePermission[]
  switches    RoleFeatureSwitch[]

  @@map("role")
}

model RolePermission {
  roleId     Int      @map("role_id")
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menuCode   String   @map("menu_code")
  canView    Boolean  @default(false) @map("can_view")
  canCreate  Boolean  @default(false) @map("can_create")
  canUpdate  Boolean  @default(false) @map("can_update")
  canDelete  Boolean  @default(false) @map("can_delete")
  canApprove Boolean  @default(false) @map("can_approve")
  canPost    Boolean  @default(false) @map("can_post")
  updatedBy  Int?     @map("updated_by")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([roleId, menuCode])
  @@map("role_permission")
}

model FeatureSwitch {
  id          Int                 @id @default(autoincrement())
  code        String              @unique
  name        String
  description String              @default("")
  hasLimit    Boolean             @default(false) @map("has_limit")
  sort        Int                 @default(0)
  roles       RoleFeatureSwitch[]

  @@map("feature_switch")
}

model RoleFeatureSwitch {
  roleId          Int           @map("role_id")
  role            Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  featureSwitchId Int           @map("feature_switch_id")
  featureSwitch   FeatureSwitch @relation(fields: [featureSwitchId], references: [id], onDelete: Cascade)
  enabled         Boolean       @default(false)
  limitValue      BigInt?       @map("limit_value")
  updatedBy       Int?          @map("updated_by")
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([roleId, featureSwitchId])
  @@map("role_feature_switch")
}

model ApprovalRule {
  docType          String   @id @map("doc_type")
  requiresApproval Boolean  @default(true) @map("requires_approval")
  minAmount        BigInt?  @map("min_amount")
  // tahap 4C: batas persen (selisih harga faktur pembelian terhadap nilai penerimaan).
  minPct           Decimal? @map("min_pct") @db.Decimal(6, 3)
  updatedBy        Int?     @map("updated_by")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("approval_rule")
}

// Hanya bertambah: trigger di migrasi menolak UPDATE, DELETE, dan TRUNCATE.
model AuditLog {
  id         Int      @id @default(autoincrement())
  at         DateTime @default(now()) @db.Timestamptz(6)
  userId     Int?     @map("user_id")
  user       AppUser? @relation(fields: [userId], references: [id])
  actorName  String   @map("actor_name")
  action     String
  docType    String?  @map("doc_type")
  docId      String?  @map("doc_id")
  summary    String   @default("")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  ip         String?
  userAgent  String?  @map("user_agent")

  @@index([at])
  @@index([userId, at])
  @@index([action, at])
  @@index([docType, docId])
  @@map("audit_log")
}

model DocSequence {
  docType String @map("doc_type")
  period  String @db.VarChar(4)
  prefix  String
  lastNo  Int    @default(0) @map("last_no")

  @@id([docType, period])
  @@map("doc_sequence")
}

// Tambahan fondasi (KONTRAK 11): sesi di database dan catatan percobaan login.
model UserSession {
  id         String    @id
  userId     Int       @map("user_id")
  user       AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  ip         String?
  userAgent  String?   @map("user_agent")

  @@index([userId])
  @@map("user_session")
}

model LoginAttempt {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now()) @db.Timestamptz(6)
  username String
  ip       String
  success  Boolean

  @@index([username, at])
  @@index([ip, at])
  @@map("login_attempt")
}

// ===== Produk, resep, menu =====

model Product {
  id                   Int                   @id @default(autoincrement())
  categoryId           Int?                  @map("category_id")
  category             ProductCategory?      @relation(fields: [categoryId], references: [id])
  baseUnitId           Int                   @map("base_unit_id")
  baseUnit             Unit                  @relation("ProdukSatuanDasar", fields: [baseUnitId], references: [id])
  bomId                Int?                  @map("bom_id")
  bom                  Bom?                  @relation("ProdukBomAssembly", fields: [bomId], references: [id])
  code                 String                @unique
  name                 String
  kind                 String                @default("bahan")
  avgCost              Decimal               @default(0) @map("avg_cost") @db.Decimal(18, 4)
  lastCost             Decimal               @default(0) @map("last_cost") @db.Decimal(18, 4)
  minStock             Decimal               @default(0) @map("min_stock") @db.Decimal(18, 3)
  receiptTolPct        Decimal               @default(0) @map("receipt_tol_pct") @db.Decimal(6, 3)
  purchasable          Boolean               @default(true)
  active               Boolean               @default(true)
  createdBy            Int?                  @map("created_by")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy            Int?                  @map("updated_by")
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  bomsAsOutput         Bom[]                 @relation("BomHasil")
  productUnits         ProductUnit[]
  bomLines             BomLine[]
  purchaseRequestLines PurchaseRequestLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  goodsReceiptLines    GoodsReceiptLine[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  purchaseReturnLines  PurchaseReturnLine[]
  directPurchaseLines  DirectPurchaseLine[]
  stockBalances        StockBalance[]
  stockLedgers         StockLedger[]
  stockAdjustmentLines StockAdjustmentLine[]
  stockOpnameLines     StockOpnameLine[]
  stockTransferLines   StockTransferLine[]
  productionOrderLines ProductionOrderLine[]
  materialIssueLines   MaterialIssueLine[]
  quickProductionLines QuickProductionLine[]
  salesOrderLines      SalesOrderLine[]
  salesInvoiceLines    SalesInvoiceLine[]
  salesReturnLines     SalesReturnLine[]
  // tahap 6A: relasi balik daftar harga pelanggan, tanpa kolom baru.
  customerPrices       CustomerPrice[]

  @@map("product")
}

model ProductCategory {
  id           Int           @id @default(autoincrement())
  name         String
  kind         String        @default("bahan")
  active       Boolean       @default(true)
  products     Product[]
  stockOpnames StockOpname[]

  @@map("product_category")
}

model Unit {
  id                   Int                   @id @default(autoincrement())
  name                 String                @unique
  symbol               String
  // tahap 4A: master satuan tidak dihapus, hanya dinonaktifkan.
  active               Boolean               @default(true)
  productsBase         Product[]             @relation("ProdukSatuanDasar")
  productUnits         ProductUnit[]
  boms                 Bom[]
  bomLines             BomLine[]
  purchaseRequestLines PurchaseRequestLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  goodsReceiptLines    GoodsReceiptLine[]
  directPurchaseLines  DirectPurchaseLine[]
  salesOrderLines      SalesOrderLine[]
  // tahap 6A: relasi balik baris faktur penjualan dan daftar harga pelanggan, tanpa kolom baru.
  salesInvoiceLines    SalesInvoiceLine[]
  customerPrices       CustomerPrice[]

  @@map("unit")
}

model ProductUnit {
  productId    Int     @map("product_id")
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitId       Int     @map("unit_id")
  unit         Unit    @relation(fields: [unitId], references: [id])
  factorToBase Decimal @map("factor_to_base") @db.Decimal(18, 6)
  isPurchase   Boolean @default(false) @map("is_purchase")
  isDefault    Boolean @default(false) @map("is_default")

  @@id([productId, unitId])
  @@map("product_unit")
}

model Bom {
  id               Int               @id @default(autoincrement())
  productId        Int?              @map("product_id")
  product          Product?          @relation("BomHasil", fields: [productId], references: [id])
  unitId           Int?              @map("unit_id")
  unit             Unit?             @relation(fields: [unitId], references: [id])
  code             String            @unique
  name             String
  kind             String            @default("menu")
  outputQty        Decimal           @default(1) @map("output_qty") @db.Decimal(18, 3)
  extraCost        BigInt            @default(0) @map("extra_cost")
  active           Boolean           @default(true)
  version          Int               @default(1)
  createdBy        Int?              @map("created_by")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy        Int?              @map("updated_by")
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  productsAssembly Product[]         @relation("ProdukBomAssembly")
  bomLines         BomLine[]
  menuItems        MenuItem[]
  productionOrders ProductionOrder[]
  quickProductions QuickProduction[]

  @@map("bom")
}

model BomLine {
  id        Int     @id @default(autoincrement())
  bomId     Int     @map("bom_id")
  bom       Bom     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  unitId    Int?    @map("unit_id")
  unit      Unit?   @relation(fields: [unitId], references: [id])
  qty       Decimal @db.Decimal(18, 3)
  wastePct  Decimal @default(0) @map("waste_pct") @db.Decimal(6, 3)
  tolPct    Decimal @default(0) @map("tol_pct") @db.Decimal(6, 3)

  // tahap 4B: satu bahan sekali per resep.
  @@unique([bomId, productId])
  @@index([bomId])
  @@map("bom_line")
}

model MenuItem {
  id          Int                @id @default(autoincrement())
  bomId       Int?               @map("bom_id")
  bom         Bom?               @relation(fields: [bomId], references: [id])
  name        String
  // Kode kategori (menu_category.code). Teks dipertahankan supaya kode yang membaca kolom ini tetap jalan.
  category    String
  categoryRef MenuCategory       @relation(fields: [category], references: [code])
  price       BigInt
  active      Boolean            @default(true)
  featured    Boolean            @default(false)
  // Foto: nama berkas di public/img situs (tanpa .webp) atau "unggahan/<berkas>" untuk foto unggahan.
  image       String?
  description String             @default("")
  kcal        Int?
  sort        Int                @default(0)
  createdBy   Int?               @map("created_by")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy   Int?               @map("updated_by")
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  saleLines   SaleLine[]         @relation("BarisMenu")
  drinkLines  SaleLine[]         @relation("BarisMinumanPaket")
  priceRows   MenuPriceHistory[]
  setsAsMain  MenuSet[]          @relation("PaketUtama")
  setsAsDrink MenuSet[]          @relation("PaketMinuman")
  promoGifts  Promo[]

  @@map("menu_item")
}

// tahap 3A: kategori menu dengan urutan.
model MenuCategory {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  name      String
  sort      Int        @default(0)
  active    Boolean    @default(true)
  createdBy Int?       @map("created_by")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy Int?       @map("updated_by")
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  items     MenuItem[]

  @@map("menu_category")
}

// tahap 3A: satu kali perubahan harga (satu menu atau massal) dan baris harga lama dan barunya.
model MenuPriceBatch {
  id        Int                @id @default(autoincrement())
  label     String
  rule      String             @default("")
  createdBy Int?               @map("created_by")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  rows      MenuPriceHistory[]

  @@map("menu_price_batch")
}

model MenuPriceHistory {
  id         Int            @id @default(autoincrement())
  batchId    Int            @map("batch_id")
  batch      MenuPriceBatch @relation(fields: [batchId], references: [id])
  menuItemId Int            @map("menu_item_id")
  menuItem   MenuItem       @relation(fields: [menuItemId], references: [id])
  oldPrice   BigInt         @map("old_price")
  newPrice   BigInt         @map("new_price")

  @@index([batchId])
  @@index([menuItemId])
  @@map("menu_price_history")
}

// tahap 3A: paket set (padanan EarlySet): satu menu utama dan satu minuman dengan harga paket.
model MenuSet {
  id          Int        @id @default(autoincrement())
  name        String
  mainItemId  Int        @map("main_item_id")
  mainItem    MenuItem   @relation("PaketUtama", fields: [mainItemId], references: [id])
  drinkItemId Int        @map("drink_item_id")
  drinkItem   MenuItem   @relation("PaketMinuman", fields: [drinkItemId], references: [id])
  normalPrice BigInt     @map("normal_price")
  price       BigInt
  image       String?
  sort        Int        @default(0)
  active      Boolean    @default(true)
  createdBy   Int?       @map("created_by")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy   Int?       @map("updated_by")
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  saleLines   SaleLine[]

  @@map("menu_set")
}

// tahap 3A: promo dengan masa berlaku. kind: persen (percent), nominal (amount), atau hadiah (giftItemId).
model Promo {
  id         Int       @id @default(autoincrement())
  name       String
  kind       String
  percent    Decimal?  @db.Decimal(6, 3)
  amount     BigInt?
  giftItemId Int?      @map("gift_item_id")
  giftItem   MenuItem? @relation(fields: [giftItemId], references: [id])
  condition  String    @default("")
  minSpend   BigInt    @default(0) @map("min_spend")
  startsOn   DateTime? @map("starts_on") @db.Date
  endsOn     DateTime? @map("ends_on") @db.Date
  active     Boolean   @default(true)
  createdBy  Int?      @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy  Int?      @map("updated_by")
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  sales      Sale[]

  @@map("promo")
}

model StockReason {
  id                   Int                   @id @default(autoincrement())
  accountId            Int?                  @map("account_id")
  account              Account?              @relation(fields: [accountId], references: [id])
  // tahap 4A: kode untuk alasan sistem (saldo_awal), kosong untuk alasan buatan pengguna.
  code                 String?               @unique
  name                 String
  appliesTo            String                @default("sesuai") @map("applies_to")
  active               Boolean               @default(true)
  stockAdjustmentLines StockAdjustmentLine[]
  stockOpnameLines     StockOpnameLine[]

  @@map("stock_reason")
}

// ===== Pembelian =====

model Supplier {
  id               Int               @id @default(autoincrement())
  payableAccountId Int?              @map("payable_account_id")
  payableAccount   Account?          @relation("PemasokAkunHutang", fields: [payableAccountId], references: [id])
  code             String            @unique
  name             String
  contact          String            @default("")
  phone            String            @default("")
  address          String            @default("")
  npwp             String            @default("")
  creditDays       Int               @default(0) @map("credit_days")
  bankName         String            @default("") @map("bank_name")
  bankAccountNo    String            @default("") @map("bank_account_no")
  // tahap 4C: catatan pemasok dari admin lama (jadwal kirim, barang yang dipasok).
  note             String            @default("")
  active           Boolean           @default(true)
  createdBy        Int?              @map("created_by")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy        Int?              @map("updated_by")
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]
  directPurchases  DirectPurchase[]
  purchasePayments PurchasePayment[]
  journalLines     JournalLine[]

  @@map("supplier")
}

model PurchaseRequest {
  id                   Int                   @id @default(autoincrement())
  locationId           Int                   @map("location_id")
  location             Location              @relation(fields: [locationId], references: [id])
  no                   String                @unique
  date                 DateTime              @db.Date
  requiredDate         DateTime?             @map("required_date") @db.Date
  orderProgress        Progress              @default(Belum) @map("order_progress")
  note                 String                @default("")
  status               DocStatus             @default(Draft)
  submittedBy          Int?                  @map("submitted_by")
  submittedAt          DateTime?             @map("submitted_at") @db.Timestamptz(6)
  approvedBy           Int?                  @map("approved_by")
  approvedAt           DateTime?             @map("approved_at") @db.Timestamptz(6)
  cancelledBy          Int?                  @map("cancelled_by")
  cancelledAt          DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  cancelReason         String?               @map("cancel_reason")
  closeReason          String?               @map("close_reason")
  closedAt             DateTime?             @map("closed_at") @db.Timestamptz(6)
  createdBy            Int?                  @map("created_by")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy            Int?                  @map("updated_by")
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  purchaseRequestLines PurchaseRequestLine[]

  @@map("purchase_request")
}

model PurchaseRequestLine {
  id                 Int                 @id @default(autoincrement())
  purchaseRequestId  Int                 @map("purchase_request_id")
  purchaseRequest    PurchaseRequest     @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  productId          Int                 @map("product_id")
  product            Product             @relation(fields: [productId], references: [id])
  unitId             Int                 @map("unit_id")
  unit               Unit                @relation(fields: [unitId], references: [id])
  qty                Decimal             @db.Decimal(18, 3)
  qtyOrdered         Decimal             @default(0) @map("qty_ordered") @db.Decimal(18, 3)
  note               String              @default("")
  purchaseOrderLines PurchaseOrderLine[]

  @@index([purchaseRequestId])
  @@map("purchase_request_line")
}

model PurchaseOrder {
  id                 Int                 @id @default(autoincrement())
  supplierId         Int                 @map("supplier_id")
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  locationId         Int                 @map("location_id")
  location           Location            @relation(fields: [locationId], references: [id])
  no                 String              @unique
  date               DateTime            @db.Date
  expectedDate       DateTime?           @map("expected_date") @db.Date
  receiveProgress    Progress            @default(Belum) @map("receive_progress")
  taxOn              Boolean             @default(false) @map("tax_on")
  subtotal           BigInt              @default(0)
  tax                BigInt              @default(0)
  total              BigInt              @default(0)
  note               String              @default("")
  status             DocStatus           @default(Draft)
  submittedBy        Int?                @map("submitted_by")
  submittedAt        DateTime?           @map("submitted_at") @db.Timestamptz(6)
  approvedBy         Int?                @map("approved_by")
  approvedAt         DateTime?           @map("approved_at") @db.Timestamptz(6)
  cancelledBy        Int?                @map("cancelled_by")
  cancelledAt        DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  cancelReason       String?             @map("cancel_reason")
  closeReason        String?             @map("close_reason")
  closedAt           DateTime?           @map("closed_at") @db.Timestamptz(6)
  // tahap 4C: nomor PO admin lama untuk impor yang idempoten.
  legacyNo           String?             @unique @map("legacy_no")
  createdBy          Int?                @map("created_by")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy          Int?                @map("updated_by")
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceipts      GoodsReceipt[]

  @@index([supplierId, date])
  @@map("purchase_order")
}

model PurchaseOrderLine {
  id                    Int                  @id @default(autoincrement())
  purchaseOrderId       Int                  @map("purchase_order_id")
  purchaseOrder         PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseRequestLineId Int?                 @map("purchase_request_line_id")
  purchaseRequestLine   PurchaseRequestLine? @relation(fields: [purchaseRequestLineId], references: [id])
  productId             Int                  @map("product_id")
  product               Product              @relation(fields: [productId], references: [id])
  unitId                Int                  @map("unit_id")
  unit                  Unit                 @relation(fields: [unitId], references: [id])
  qty                   Decimal              @db.Decimal(18, 3)
  // tahap 4C: faktor satuan beli ke satuan dasar saat baris dibuat.
  factor                Decimal              @default(1) @db.Decimal(18, 6)
  price                 BigInt
  disc                  BigInt               @default(0)
  taxPct                Decimal              @default(0) @map("tax_pct") @db.Decimal(6, 3)
  qtyReceived           Decimal              @default(0) @map("qty_received") @db.Decimal(18, 3)
  qtyReplace            Decimal              @default(0) @map("qty_replace") @db.Decimal(18, 3)
  isFree                Boolean              @default(false) @map("is_free")
  goodsReceiptLines     GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@map("purchase_order_line")
}

model GoodsReceipt {
