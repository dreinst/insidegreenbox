// Satu dari tiga FK tagihan terisi per baris.
model PurchasePaymentAlloc {
  id                Int              @id @default(autoincrement())
  purchasePaymentId Int              @map("purchase_payment_id")
  purchasePayment   PurchasePayment  @relation(fields: [purchasePaymentId], references: [id], onDelete: Cascade)
  purchaseInvoiceId Int?             @map("purchase_invoice_id")
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
