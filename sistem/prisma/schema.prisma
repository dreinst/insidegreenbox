model MemberTier {
  id          Int      @id @default(autoincrement())
  name        String
  minVisits   Int      @default(0) @map("min_visits")
  discountPct Decimal  @default(0) @map("discount_pct") @db.Decimal(6, 3)
  perk        String   @default("")
  active      Boolean  @default(true)
  members     Member[]

  @@map("member_tier")
}

model Member {
  id         Int         @id @default(autoincrement())
  tierId     Int?        @map("tier_id")
  tier       MemberTier? @relation(fields: [tierId], references: [id])
  name       String
  wa         String      @unique
  visits     Int         @default(0)
  discountOn Boolean     @default(false) @map("discount_on")
  active     Boolean     @default(true)
  joinedAt   DateTime    @default(now()) @map("joined_at") @db.Timestamptz(6)
  note       String      @default("")
  createdBy  Int?        @map("created_by")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy  Int?        @map("updated_by")
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  sales      Sale[]

  @@map("member")
}

model Shift {
  id                 Int                 @id @default(autoincrement())
  userId             Int                 @map("user_id")
  user               AppUser             @relation("ShiftKasir", fields: [userId], references: [id])
  locationId         Int                 @map("location_id")
  location           Location            @relation(fields: [locationId], references: [id])
  approvedBy         Int?                @map("approved_by")
  approver           AppUser?            @relation("ShiftPenyetuju", fields: [approvedBy], references: [id])
  approvedAt         DateTime?           @map("approved_at") @db.Timestamptz(6)
  openedAt           DateTime            @default(now()) @map("opened_at") @db.Timestamptz(6)
  openCash           BigInt              @default(0) @map("open_cash")
  closedAt           DateTime?           @map("closed_at") @db.Timestamptz(6)
  expectedCash       BigInt?             @map("expected_cash")
  countedCash        BigInt?             @map("counted_cash")
  cashDiff           BigInt?             @map("cash_diff")
  denominationsJson  Json?               @map("denominations_json")
  note               String              @default("")
  status             ShiftStatus         @default(Buka)
  // tahap 3B: siapa yang menutup, batas selisih yang berlaku saat ditutup, dan catatan persetujuan Owner.
  // tahap 6C: shift baru tidak lagi butuh persetujuan, jadi diff_limit selalu kosong untuk shift baru (butir 121).
  closedBy           Int?                @map("closed_by")
  diffLimit          BigInt?             @map("diff_limit")
  approvalNote       String?             @map("approval_note")
  // tahap 6C: true bila shift ditutup dengan selisih tanpa alasan; false lagi sesudah alasan diisi (KONTRAK 11 butir 121).
  reasonMissing      Boolean             @default(false) @map("reason_missing")
  shiftCashMoves     ShiftCashMove[]
  sales              Sale[]
  posSettlementLines PosSettlementLine[]

  @@index([userId, openedAt])
  @@map("shift")
}

model ShiftCashMove {
  id        Int      @id @default(autoincrement())
  shiftId   Int      @map("shift_id")
  shift     Shift    @relation(fields: [shiftId], references: [id])
  at        DateTime @default(now()) @db.Timestamptz(6)
  kind      String
  amount    BigInt
  reason    String
  createdBy Int?     @map("created_by")

  @@index([shiftId])
  @@map("shift_cash_move")
}

model Sale {
  id             Int           @id @default(autoincrement())
  shiftId        Int           @map("shift_id")
  shift          Shift         @relation(fields: [shiftId], references: [id])
  memberId       Int?          @map("member_id")
  member         Member?       @relation(fields: [memberId], references: [id])
  no             String        @unique
  at             DateTime      @default(now()) @db.Timestamptz(6)
  mode           String
  tableNo        String?       @map("table_no")
  sub            BigInt        @default(0)
  disc           BigInt        @default(0)
  svc            BigInt        @default(0)
  tax            BigInt        @default(0)
  total          BigInt        @default(0)
  hpp            BigInt        @default(0)
  status         SaleStatus    @default(Selesai)
  voidBy         Int?          @map("void_by")
  voidAt         DateTime?     @map("void_at") @db.Timestamptz(6)
  voidReason     String?       @map("void_reason")
  createdBy      Int?          @map("created_by")
  // tahap 3B: persen yang berlaku saat transaksi dan penyetuju void lewat PIN.
  memberPct      Decimal       @default(0) @map("member_pct") @db.Decimal(6, 3)
  svcPct         Decimal       @default(0) @map("svc_pct") @db.Decimal(6, 3)
  taxPct         Decimal       @default(0) @map("tax_pct") @db.Decimal(6, 3)
  voidApprovedBy Int?          @map("void_approved_by")
  // Keputusan pemilik 24 November 2026: selisih pembulatan bagian tunai ke Rp 500 (KONTRAK 11 butir 155).
  // Uang diterima = total + rounding.
  rounding       BigInt        @default(0)
  // Perbaikan panduan 25 November 2026: promo otomatis (KONTRAK 11 butir 160). disc tetap seluruh potongan; promo_disc
  // bagian disc dari promo. promo_name nama promo saat dijual.
  promoId        Int?          @map("promo_id")
  promo          Promo?        @relation(fields: [promoId], references: [id], onDelete: SetNull)
  promoName      String        @default("") @map("promo_name")
  promoDisc      BigInt        @default(0) @map("promo_disc")
  saleLines      SaleLine[]
  salePayments   SalePayment[]

  @@index([shiftId])
  @@index([at])
  @@index([promoId])
  @@map("sale")
}

model SaleLine {
  id         Int       @id @default(autoincrement())
  saleId     Int       @map("sale_id")
  sale       Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  menuItemId Int       @map("menu_item_id")
  menuItem   MenuItem  @relation("BarisMenu", fields: [menuItemId], references: [id])
  qty        Int
  price      BigInt
  note       String    @default("")
  hpp        BigInt    @default(0)
  // tahap 3B: nama dan kategori menu saat dijual, supaya struk lama tidak ikut berubah.
  name       String    @default("")
  category   String    @default("")
  // tahap 3C: baris paket set. menu_set_id terisi berarti baris ini paket; menu_item_id berisi menu utama paket
  // dan set_drink_item_id minumannya saat dijual. Keduanya terisi atau keduanya kosong (CHECK di migrasi).
  menuSetId  Int?      @map("menu_set_id")
  menuSet    MenuSet?  @relation(fields: [menuSetId], references: [id], onDelete: Restrict)
  drinkId    Int?      @map("set_drink_item_id")
  drinkItem  MenuItem? @relation("BarisMinumanPaket", fields: [drinkId], references: [id], onDelete: Restrict)
  // KONTRAK 11 butir 160: baris menu gratis dari promo hadiah (harga 0, CHECK di migrasi).
  promoGift  Boolean   @default(false) @map("promo_gift")

  @@index([saleId])
  @@map("sale_line")
}

model SalePayment {
  id              Int           @id @default(autoincrement())
  saleId          Int           @map("sale_id")
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethodId Int           @map("payment_method_id")
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  amount          BigInt
  paid            BigInt
  change          BigInt        @default(0)

  @@index([saleId])
  @@map("sale_payment")
}

model PosSettlement {
  id                 Int                 @id @default(autoincrement())
  paymentMethodId    Int                 @map("payment_method_id")
  paymentMethod      PaymentMethod       @relation(fields: [paymentMethodId], references: [id])
  // tahap 5A: akun tujuan diisi saat modul akuntansi (COA) ada; rekening tujuan dari bank_account.
  toAccountId        Int?                @map("to_account_id")
  toAccount          Account?            @relation("SetoranAkunTujuan", fields: [toAccountId], references: [id], onDelete: Restrict)
  bankAccountId      Int?                @map("bank_account_id")
  bankAccount        BankAccount?        @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  no                 String              @unique
  date               DateTime            @db.Date
  expectedTotal      BigInt              @default(0) @map("expected_total")
  actualTotal        BigInt              @default(0) @map("actual_total")
  mdrFee             BigInt              @default(0) @map("mdr_fee")
  diff               BigInt              @default(0)
  proofFile          String?             @map("proof_file")
  note               String              @default("")
  status             DocStatus           @default(Draft)
  submittedBy        Int?                @map("submitted_by")
  submittedAt        DateTime?           @map("submitted_at") @db.Timestamptz(6)
  approvedBy         Int?                @map("approved_by")
  approvedAt         DateTime?           @map("approved_at") @db.Timestamptz(6)
  cancelledBy        Int?                @map("cancelled_by")
  cancelledAt        DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  cancelReason       String?             @map("cancel_reason")
  postedBy           Int?                @map("posted_by")
  postedAt           DateTime?           @map("posted_at") @db.Timestamptz(6)
  reversalJournalId  Int?                @map("reversal_journal_id")
  createdBy          Int?                @map("created_by")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy          Int?                @map("updated_by")
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  posSettlementLines PosSettlementLine[]

  // Indeks unik sebagian (date, payment_method_id) WHERE status <> 'Batal' ada di migrasi tahap5a_setoran:
  // satu setoran per tanggal per metode bayar.
  @@index([date])
  @@map("pos_settlement")
}

// Satu shift dan metode hanya boleh masuk satu setoran yang tidak Batal; dicek di modul setoran.
model PosSettlementLine {
  id              Int           @id @default(autoincrement())
  posSettlementId Int           @map("pos_settlement_id")
  posSettlement   PosSettlement @relation(fields: [posSettlementId], references: [id], onDelete: Cascade)
  shiftId         Int           @map("shift_id")
  shift           Shift         @relation(fields: [shiftId], references: [id])
  expected        BigInt        @default(0)
  actual          BigInt        @default(0)
  diff            BigInt        @default(0)
  note            String        @default("")
  // MDR bawaan shift itu saat baris dibuat atau dimuat ulang (KONTRAK 11 butir 131). Kosong untuk baris lama.
  mdr             BigInt?
  // tahap 5A: salinan metode bayar kepala dan penanda batal, untuk indeks unik sebagian
  // (shift_id, payment_method_id) WHERE NOT cancelled di migrasi: satu shift dan metode hanya di satu setoran
  // yang tidak Batal.
  paymentMethodId Int           @map("payment_method_id")
  cancelled       Boolean       @default(false)

  @@index([posSettlementId])
  @@index([shiftId])
  @@map("pos_settlement_line")
}

// ===== Akun, jurnal, kas, bank =====

model Account {
  id                    Int                   @id @default(autoincrement())
  parentId              Int?                  @map("parent_id")
  parent                Account?              @relation("PohonAkun", fields: [parentId], references: [id])
  children              Account[]             @relation("PohonAkun")
  code                  String                @unique
  name                  String
  kind                  AccountKind
  isCashBank            Boolean               @default(false) @map("is_cash_bank")
  isPostable            Boolean               @default(true) @map("is_postable")
  active                Boolean               @default(true)
  // tahap 5B: keterangan dan kolom audit master (KONTRAK 3.1).
  note                  String                @default("")
  createdBy             Int?                  @map("created_by")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy             Int?                  @map("updated_by")
  updatedAt             DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  suppliersPayable      Supplier[]            @relation("PemasokAkunHutang")
  purchaseInvoiceLines  PurchaseInvoiceLine[] @relation("FakturBeliAkunBeban")
  directPurchasesCash   DirectPurchase[]      @relation("BeliLangsungAkunKas")
  directPurchaseLines   DirectPurchaseLine[]  @relation("BeliLangsungAkunBeban")
  purchasePaymentsFrom  PurchasePayment[]     @relation("BayarBeliAkunSumber")
  posSettlementsTo      PosSettlement[]       @relation("SetoranAkunTujuan")
  paymentMethodsClear   PaymentMethod[]       @relation("MetodeAkunKliring")
  paymentMethodsDeposit PaymentMethod[]       @relation("MetodeAkunSetoran")
  cashTransactions      CashTransaction[]     @relation("KasAkun")
  cashTransactionsTo    CashTransaction[]     @relation("KasAkunTujuan")
  customersReceivable   Customer[]            @relation("PelangganAkunPiutang")
  customerPaymentsTo    CustomerPayment[]     @relation("TerimaPelangganAkun")
  fixedAssetsAsset      FixedAsset[]          @relation("AsetAkunAset")
  fixedAssetsAccum      FixedAsset[]          @relation("AsetAkunAkumulasi")
  fixedAssetsExpense    FixedAsset[]          @relation("AsetAkunBeban")
  assetDisposalsCash    AssetDisposal[]       @relation("LepasAsetAkunKas")
  stockReasons          StockReason[]
  accountMappings       AccountMapping[]
  bankAccounts          BankAccount[]
  journalLines          JournalLine[]
  cashTransactionLines  CashTransactionLine[]
  budgetLines           BudgetLine[]

  @@map("account")
}

model AccountMapping {
  key       String   @id
  accountId Int      @map("account_id")
  account   Account  @relation(fields: [accountId], references: [id])
  updatedBy Int?     @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("account_mapping")
}

model FiscalPeriod {
  id                 Int                 @id @default(autoincrement())
  yearMonth          String              @unique @map("year_month") @db.VarChar(7)
  stockClosedAt      DateTime?           @map("stock_closed_at") @db.Timestamptz(6)
  closedAt           DateTime?           @map("closed_at") @db.Timestamptz(6)
  closedBy           Int?                @map("closed_by")
  closer             AppUser?            @relation(fields: [closedBy], references: [id])
  status             PeriodStatus        @default(Terbuka)
  // tahap 5B: periode yang dibuka lagi oleh Owner menyimpan alasan dan pelakunya (riwayat lengkap di audit_log).
  reopenedBy         Int?                @map("reopened_by")
  reopenedAt         DateTime?           @map("reopened_at") @db.Timestamptz(6)
  reopenReason       String?             @map("reopen_reason")
  journals           Journal[]
  assetDepreciations AssetDepreciation[]

  @@map("fiscal_period")
}

model PaymentMethod {
  id                Int                @id @default(autoincrement())
  clearingAccountId Int?               @map("clearing_account_id")
  clearingAccount   Account?           @relation("MetodeAkunKliring", fields: [clearingAccountId], references: [id])
  depositAccountId  Int?               @map("deposit_account_id")
  depositAccount    Account?           @relation("MetodeAkunSetoran", fields: [depositAccountId], references: [id])
  name              String             @unique
  kind              String             @default("tunai")
  mdrPct            Decimal            @default(0) @map("mdr_pct") @db.Decimal(6, 3)
  openDrawer        Boolean            @default(false) @map("open_drawer")
  active            Boolean            @default(true)
  salePayments      SalePayment[]
  posSettlements    PosSettlement[]
  tarifMdr          PaymentMethodMdr[]

  @@map("payment_method")
}

// tahap 6C: riwayat tarif MDR per metode bayar (KONTRAK 11 butir 123). Tarif yang berlaku untuk satu penjualan
// adalah baris dengan effective_from paling akhir yang tidak sesudah tanggal WIB penjualan. free_limit kosong
// berarti tidak ada nominal yang bebas MDR. Baris tidak diubah atau dihapus; tarif baru ditambah sebagai baris baru.
model PaymentMethodMdr {
  id              Int           @id @default(autoincrement())
  paymentMethodId Int           @map("payment_method_id")
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  mdrPct          Decimal       @map("mdr_pct") @db.Decimal(6, 3)
  freeLimit       BigInt?       @map("free_limit")
  effectiveFrom   DateTime      @map("effective_from") @db.Date
  note            String        @default("")
  createdBy       Int?          @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([paymentMethodId, effectiveFrom])
  @@map("payment_method_mdr")
}

model BankAccount {
  id                 Int                 @id @default(autoincrement())
  // tahap 5A: akun COA diisi saat modul akuntansi ada, jadi boleh kosong.
  accountId          Int?                @map("account_id")
  account            Account?            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  bankName           String              @map("bank_name")
  accountNo          String              @map("account_no")
  holderName         String              @default("") @map("holder_name")
  active             Boolean             @default(true)
  createdBy          Int?                @map("created_by")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy          Int?                @map("updated_by")
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bankStatementLines BankStatementLine[]
  bankReconciles     BankReconcile[]
  posSettlements     PosSettlement[]

  @@map("bank_account")
}

model Journal {
  id           Int           @id @default(autoincrement())
  periodId     Int?          @map("period_id")
  period       FiscalPeriod? @relation(fields: [periodId], references: [id])
  reversalOfId Int?          @map("reversal_of_id")
  reversalOf   Journal?      @relation("JurnalBalik", fields: [reversalOfId], references: [id])
  reversals    Journal[]     @relation("JurnalBalik")
  no           String        @unique
  date         DateTime      @db.Date
  sourceType   String        @map("source_type")
  sourceId     Int?          @map("source_id")
  memo         String        @default("")
  // tahap 5B: posted_at kosong berarti belum berlaku (memorial Draft atau Diajukan). Jurnal dari dokumen selalu Diposting.
  postedBy     Int?          @map("posted_by")
  postedAt     DateTime?     @map("posted_at") @db.Timestamptz(6)
  // tahap 5B: nomor dokumen sumber untuk tampilan, dan alur status memorial (jurnal manual).
  docNo        String        @default("") @map("doc_no")
  status       DocStatus     @default(Diposting)
  createdBy    Int?          @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy    Int?          @map("updated_by")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  submittedBy  Int?          @map("submitted_by")
  submittedAt  DateTime?     @map("submitted_at") @db.Timestamptz(6)
  approvedBy   Int?          @map("approved_by")
  approvedAt   DateTime?     @map("approved_at") @db.Timestamptz(6)
  cancelledBy  Int?          @map("cancelled_by")
  cancelledAt  DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?       @map("cancel_reason")
  // audit C: kunci pemetaan yang dipakai jurnal ini beserta id akunnya ({"grni": 30, "persediaan.3|persediaan": 12}),
  // supaya jurnal baliknya memakai akun yang sama walau pemetaan sudah diganti (KONTRAK 11 butir C-2).
  mappingSnapshot Json?      @map("mapping_snapshot")
  journalLines JournalLine[]

  // Indeks unik sebagian di migrasi tahap5b: satu jurnal maju per dokumen sumber (selain memorial) dan satu jurnal
  // balik per jurnal.
  @@index([sourceType, sourceId])
  @@index([date])
  @@map("journal")
}

model JournalLine {
  id                 Int                 @id @default(autoincrement())
  journalId          Int                 @map("journal_id")
  journal            Journal             @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId          Int                 @map("account_id")
  account            Account             @relation(fields: [accountId], references: [id])
  supplierId         Int?                @map("supplier_id")
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  customerId         Int?                @map("customer_id")
  customer           Customer?           @relation(fields: [customerId], references: [id])
  debit              BigInt              @default(0)
  credit             BigInt              @default(0)
  memo               String              @default("")
  clearedAt          DateTime?           @map("cleared_at") @db.Date
  // tahap 5C: rekening bank_account yang digerakkan baris ini (tanpa kunci asing, KONTRAK 11), untuk Rekonsiliasi Bank.
  bankAccountId      Int?                @map("bank_account_id")
  bankReconcileMatch BankReconcileMatch?

  @@index([journalId])
  @@index([accountId, journalId])
  @@index([bankAccountId])
  @@map("journal_line")
}

model CashTransaction {
  id                   Int                   @id @default(autoincrement())
  accountId            Int                   @map("account_id")
  account              Account               @relation("KasAkun", fields: [accountId], references: [id])
  toAccountId          Int?                  @map("to_account_id")
  toAccount            Account?              @relation("KasAkunTujuan", fields: [toAccountId], references: [id])
  no                   String                @unique
  date                 DateTime              @db.Date
  kind                 String
  // tahap 5C: rekening sumber dan tujuan (bank_account tanpa kunci asing); kosong berarti Kas Besar. account_id dan
  // to_account_id berisi akun COA hasil pemetaan, diperbarui saat diposting.
  bankAccountId        Int?                  @map("bank_account_id")
  toBankAccountId      Int?                  @map("to_bank_account_id")
  partyName            String                @default("") @map("party_name")
  amount               BigInt                @default(0)
  note                 String                @default("")
  status               DocStatus             @default(Draft)
  submittedBy          Int?                  @map("submitted_by")
  submittedAt          DateTime?             @map("submitted_at") @db.Timestamptz(6)
  approvedBy           Int?                  @map("approved_by")
  approvedAt           DateTime?             @map("approved_at") @db.Timestamptz(6)
  cancelledBy          Int?                  @map("cancelled_by")
  cancelledAt          DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  cancelReason         String?               @map("cancel_reason")
  postedBy             Int?                  @map("posted_by")
  postedAt             DateTime?             @map("posted_at") @db.Timestamptz(6)
  reversalJournalId    Int?                  @map("reversal_journal_id")
  createdBy            Int?                  @map("created_by")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy            Int?                  @map("updated_by")
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  cashTransactionLines CashTransactionLine[]

  @@map("cash_transaction")
}

model CashTransactionLine {
  id                Int             @id @default(autoincrement())
  cashTransactionId Int             @map("cash_transaction_id")
  cashTransaction   CashTransaction @relation(fields: [cashTransactionId], references: [id], onDelete: Cascade)
  accountId         Int             @map("account_id")
  account           Account         @relation(fields: [accountId], references: [id])
  amount            BigInt
  memo              String          @default("")

  @@index([cashTransactionId])
  @@map("cash_transaction_line")
}

model BankStatementLine {
  id                   Int                  @id @default(autoincrement())
  bankAccountId        Int                  @map("bank_account_id")
  bankAccount          BankAccount          @relation(fields: [bankAccountId], references: [id])
  bankReconcileId      Int?                 @map("bank_reconcile_id")
  bankReconcile        BankReconcile?       @relation(fields: [bankReconcileId], references: [id])
  date                 DateTime             @db.Date
  description          String
  ref                  String               @default("")
  debit                BigInt               @default(0)
  credit               BigInt               @default(0)
  balance              BigInt?
  importBatch          String               @map("import_batch")
  matchStatus          MatchStatus          @default(BelumCocok) @map("match_status")
  // tahap 5C: sidik baris untuk melewati baris yang sudah pernah diimpor, dan jejak impor.
  dedupKey             String               @map("dedup_key")
  createdBy            Int?                 @map("created_by")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  bankReconcileMatches BankReconcileMatch[]

  @@unique([bankAccountId, dedupKey])
  @@index([bankAccountId, date])
  @@map("bank_statement_line")
}

model BankReconcile {
  id                 Int                 @id @default(autoincrement())
  bankAccountId      Int                 @map("bank_account_id")
  bankAccount        BankAccount         @relation(fields: [bankAccountId], references: [id])
  no                 String              @unique
  periodFrom         DateTime            @map("period_from") @db.Date
  periodTo           DateTime            @map("period_to") @db.Date
  stmtOpening        BigInt              @default(0) @map("stmt_opening")
  stmtClosing        BigInt              @default(0) @map("stmt_closing")
  bookClosing        BigInt              @default(0) @map("book_closing")
  // tahap 5C: jurnal bank yang belum cair per akhir periode (book_closing - outstanding = saldo rekening koran).
  outstanding        BigInt              @default(0)
  diff               BigInt              @default(0)
  note               String              @default("")
  status             DocStatus           @default(Draft)
  submittedBy        Int?                @map("submitted_by")
  submittedAt        DateTime?           @map("submitted_at") @db.Timestamptz(6)
  approvedBy         Int?                @map("approved_by")
  approvedAt         DateTime?           @map("approved_at") @db.Timestamptz(6)
  cancelledBy        Int?                @map("cancelled_by")
  cancelledAt        DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  cancelReason       String?             @map("cancel_reason")
  postedBy           Int?                @map("posted_by")
  postedAt           DateTime?           @map("posted_at") @db.Timestamptz(6)
  reversalJournalId  Int?                @map("reversal_journal_id")
  createdBy          Int?                @map("created_by")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy          Int?                @map("updated_by")
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  bankStatementLines BankStatementLine[]

  @@map("bank_reconcile")
}

model BankReconcileMatch {
  id                  Int               @id @default(autoincrement())
  bankStatementLineId Int               @map("bank_statement_line_id")
  bankStatementLine   BankStatementLine @relation(fields: [bankStatementLineId], references: [id])
  journalLineId       Int               @unique @map("journal_line_id")
  journalLine         JournalLine       @relation(fields: [journalLineId], references: [id])
  amount              BigInt
  matchedBy           Int?              @map("matched_by")
  matchedAt           DateTime          @default(now()) @map("matched_at") @db.Timestamptz(6)

  @@index([bankStatementLineId])
  @@map("bank_reconcile_match")
}

// ===== Penjualan B2B =====

model Customer {
  id                  Int               @id @default(autoincrement())
  receivableAccountId Int?              @map("receivable_account_id")
  receivableAccount   Account?          @relation("PelangganAkunPiutang", fields: [receivableAccountId], references: [id])
  code                String            @unique
  name                String
  category            String            @default("")
  contact             String            @default("")
  phone               String            @default("")
  address             String            @default("")
  paymentDays         Int               @default(0) @map("payment_days")
  // tahap 6A: NPWP dan catatan pelanggan.
  npwp                String            @default("")
  note                String            @default("")
  active              Boolean           @default(true)
  createdBy           Int?              @map("created_by")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy           Int?              @map("updated_by")
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  journalLines        JournalLine[]
  salesOrders         SalesOrder[]
  salesInvoices       SalesInvoice[]
  customerPayments    CustomerPayment[]
  // tahap 6A
  customerPrices      CustomerPrice[]
  salesReturns        SalesReturn[]

  @@map("customer")
}

// tahap 6A: daftar harga khusus pelanggan per produk dan satuan jual (KONTRAK 11). Harga rupiah bulat per satuan itu.
model CustomerPrice {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  Int      @map("product_id")
  product    Product  @relation(fields: [productId], references: [id])
  unitId     Int      @map("unit_id")
  unit       Unit     @relation(fields: [unitId], references: [id])
  price      BigInt
  createdBy  Int?     @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy  Int?     @map("updated_by")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([customerId, productId, unitId])
  @@map("customer_price")
}

model SalesOrder {
  id              Int              @id @default(autoincrement())
  customerId      Int              @map("customer_id")
  customer        Customer         @relation(fields: [customerId], references: [id])
  locationId      Int              @map("location_id")
  location        Location         @relation(fields: [locationId], references: [id])
  no              String           @unique
  date            DateTime         @db.Date
  requiredDate    DateTime?        @map("required_date") @db.Date
  subtotal        BigInt           @default(0)
  tax             BigInt           @default(0)
  total           BigInt           @default(0)
  invoiceProgress Progress         @default(Belum) @map("invoice_progress")
  // tahap 6A: nomor PO atau rujukan dari pelanggan.
  customerRef     String           @default("") @map("customer_ref")
  note            String           @default("")
  status          DocStatus        @default(Draft)
  submittedBy     Int?             @map("submitted_by")
  submittedAt     DateTime?        @map("submitted_at") @db.Timestamptz(6)
  approvedBy      Int?             @map("approved_by")
  approvedAt      DateTime?        @map("approved_at") @db.Timestamptz(6)
  cancelledBy     Int?             @map("cancelled_by")
  cancelledAt     DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  cancelReason    String?          @map("cancel_reason")
  closeReason     String?          @map("close_reason")
  closedAt        DateTime?        @map("closed_at") @db.Timestamptz(6)
  createdBy       Int?             @map("created_by")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy       Int?             @map("updated_by")
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  salesOrderLines SalesOrderLine[]
  salesInvoices   SalesInvoice[]

  @@map("sales_order")
}

model SalesOrderLine {
  id                Int                @id @default(autoincrement())
  salesOrderId      Int                @map("sales_order_id")
  salesOrder        SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId         Int                @map("product_id")
  product           Product            @relation(fields: [productId], references: [id])
  unitId            Int                @map("unit_id")
  unit              Unit               @relation(fields: [unitId], references: [id])
  qty               Decimal            @db.Decimal(18, 3)
  // tahap 6A: faktor satuan jual ke satuan dasar saat baris dibuat.
  factor            Decimal            @default(1) @db.Decimal(18, 6)
  price             BigInt
  disc              BigInt             @default(0)
  taxPct            Decimal            @default(0) @map("tax_pct") @db.Decimal(6, 3)
  qtyInvoiced       Decimal            @default(0) @map("qty_invoiced") @db.Decimal(18, 3)
  salesInvoiceLines SalesInvoiceLine[]

  @@index([salesOrderId])
  @@map("sales_order_line")
}

model SalesInvoice {
  id                    Int                    @id @default(autoincrement())
  customerId            Int                    @map("customer_id")
  customer              Customer               @relation(fields: [customerId], references: [id])
  salesOrderId          Int?                   @map("sales_order_id")
  salesOrder            SalesOrder?            @relation(fields: [salesOrderId], references: [id])
  locationId            Int                    @map("location_id")
  location              Location               @relation(fields: [locationId], references: [id])
  no                    String                 @unique
  date                  DateTime               @db.Date
  dueDate               DateTime?              @map("due_date") @db.Date
  subtotal              BigInt                 @default(0)
  tax                   BigInt                 @default(0)
  total                 BigInt                 @default(0)
  paidAmount            BigInt                 @default(0) @map("paid_amount")
  payStatus             PayStatus              @default(BelumBayar) @map("pay_status")
  // tahap 6A: rujukan pelanggan dan HPP total barang keluar (nilai keluar mesin stok saat Diposting).
  customerRef           String                 @default("") @map("customer_ref")
  hpp                   BigInt                 @default(0)
  note                  String                 @default("")
  status                DocStatus              @default(Draft)
  submittedBy           Int?                   @map("submitted_by")
  submittedAt           DateTime?              @map("submitted_at") @db.Timestamptz(6)
  approvedBy            Int?                   @map("approved_by")
  approvedAt            DateTime?              @map("approved_at") @db.Timestamptz(6)
  cancelledBy           Int?                   @map("cancelled_by")
  cancelledAt           DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  cancelReason          String?                @map("cancel_reason")
  postedBy              Int?                   @map("posted_by")
  postedAt              DateTime?              @map("posted_at") @db.Timestamptz(6)
  reversalJournalId     Int?                   @map("reversal_journal_id")
  createdBy             Int?                   @map("created_by")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy             Int?                   @map("updated_by")
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  salesInvoiceLines     SalesInvoiceLine[]
  customerPaymentAllocs CustomerPaymentAlloc[]
  salesReturns          SalesReturn[]

  @@map("sales_invoice")
}

model SalesInvoiceLine {
  id               Int               @id @default(autoincrement())
  salesInvoiceId   Int               @map("sales_invoice_id")
  salesInvoice     SalesInvoice      @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  salesOrderLineId Int?              @map("sales_order_line_id")
  salesOrderLine   SalesOrderLine?   @relation(fields: [salesOrderLineId], references: [id])
  productId        Int               @map("product_id")
  product          Product           @relation(fields: [productId], references: [id])
  // tahap 6A: satuan jual dan faktornya, jumlah baris, dan HPP baris (rupiah, positif) dari mesin stok.
  unitId           Int               @map("unit_id")
  unit             Unit              @relation(fields: [unitId], references: [id])
  factor           Decimal           @default(1) @db.Decimal(18, 6)
  qty              Decimal           @db.Decimal(18, 3)
  price            BigInt
  disc             BigInt            @default(0)
  taxPct           Decimal           @default(0) @map("tax_pct") @db.Decimal(6, 3)
  lineTotal        BigInt            @default(0) @map("line_total")
  unitCost         Decimal           @default(0) @map("unit_cost") @db.Decimal(18, 4)
  value            BigInt            @default(0)
  qtyReturned      Decimal           @default(0) @map("qty_returned") @db.Decimal(18, 3)
  salesReturnLines SalesReturnLine[]

  @@index([salesInvoiceId])
  @@map("sales_invoice_line")
}

model CustomerPayment {
  id                    Int                    @id @default(autoincrement())
  customerId            Int                    @map("customer_id")
  customer              Customer               @relation(fields: [customerId], references: [id])
  // tahap 6A: boleh kosong sampai COA dipakai; rekening tujuan di bank_account_id (kosong berarti kas).
  toAccountId           Int?                   @map("to_account_id")
  toAccount             Account?               @relation("TerimaPelangganAkun", fields: [toAccountId], references: [id])
  bankAccountId         Int?                   @map("bank_account_id")
  no                    String                 @unique
  date                  DateTime               @db.Date
  amount                BigInt                 @default(0)
  bankFee               BigInt                 @default(0) @map("bank_fee")
  unallocated           BigInt                 @default(0)
  note                  String                 @default("")
  status                DocStatus              @default(Draft)
  submittedBy           Int?                   @map("submitted_by")
  submittedAt           DateTime?              @map("submitted_at") @db.Timestamptz(6)
  approvedBy            Int?                   @map("approved_by")
  approvedAt            DateTime?              @map("approved_at") @db.Timestamptz(6)
  cancelledBy           Int?                   @map("cancelled_by")
  cancelledAt           DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  cancelReason          String?                @map("cancel_reason")
  postedBy              Int?                   @map("posted_by")
  postedAt              DateTime?              @map("posted_at") @db.Timestamptz(6)
  reversalJournalId     Int?                   @map("reversal_journal_id")
  createdBy             Int?                   @map("created_by")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy             Int?                   @map("updated_by")
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  customerPaymentAllocs CustomerPaymentAlloc[]

  @@map("customer_payment")
}

model CustomerPaymentAlloc {
  id                Int             @id @default(autoincrement())
  customerPaymentId Int             @map("customer_payment_id")
  customerPayment   CustomerPayment @relation(fields: [customerPaymentId], references: [id], onDelete: Cascade)
  // tahap 6A: tepat satu dari faktur atau nota kredit retur (CHECK di migrasi).
  salesInvoiceId    Int?            @map("sales_invoice_id")
  salesInvoice      SalesInvoice?   @relation(fields: [salesInvoiceId], references: [id])
  salesReturnId     Int?            @map("sales_return_id")
  salesReturn       SalesReturn?    @relation(fields: [salesReturnId], references: [id])
  amount            BigInt

  @@index([customerPaymentId])
  @@map("customer_payment_alloc")
}

model SalesReturn {
  id                    Int                    @id @default(autoincrement())
  salesInvoiceId        Int                    @map("sales_invoice_id")
  salesInvoice          SalesInvoice           @relation(fields: [salesInvoiceId], references: [id])
  // tahap 6A: salinan pelanggan faktur asal, HPP yang kembali, dan pemakaian nota kredit (total).
  customerId            Int                    @map("customer_id")
  customer              Customer               @relation(fields: [customerId], references: [id])
  locationId            Int                    @map("location_id")
  location              Location               @relation(fields: [locationId], references: [id])
  no                    String                 @unique
  date                  DateTime               @db.Date
  reason                String
  subtotal              BigInt                 @default(0)
  tax                   BigInt                 @default(0)
  total                 BigInt                 @default(0)
  value                 BigInt                 @default(0)
  creditUsed            BigInt                 @default(0) @map("credit_used")
  status                DocStatus              @default(Draft)
  submittedBy           Int?                   @map("submitted_by")
  submittedAt           DateTime?              @map("submitted_at") @db.Timestamptz(6)
  approvedBy            Int?                   @map("approved_by")
  approvedAt            DateTime?              @map("approved_at") @db.Timestamptz(6)
  cancelledBy           Int?                   @map("cancelled_by")
  cancelledAt           DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  cancelReason          String?                @map("cancel_reason")
  postedBy              Int?                   @map("posted_by")
  postedAt              DateTime?              @map("posted_at") @db.Timestamptz(6)
  reversalJournalId     Int?                   @map("reversal_journal_id")
  createdBy             Int?                   @map("created_by")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy             Int?                   @map("updated_by")
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  salesReturnLines      SalesReturnLine[]
  customerPaymentAllocs CustomerPaymentAlloc[]

  @@map("sales_return")
}

model SalesReturnLine {
  id                 Int              @id @default(autoincrement())
  salesReturnId      Int              @map("sales_return_id")
  salesReturn        SalesReturn      @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  salesInvoiceLineId Int              @map("sales_invoice_line_id")
  salesInvoiceLine   SalesInvoiceLine @relation(fields: [salesInvoiceLineId], references: [id])
  productId          Int              @map("product_id")
  product            Product          @relation(fields: [productId], references: [id])
  // qty dalam satuan jual baris faktur asal.
  qty                Decimal          @db.Decimal(18, 3)
  unitCost           Decimal          @default(0) @map("unit_cost") @db.Decimal(18, 4)
  // tahap 6A: harga jual asal, nota kredit baris (qty x harga), dan HPP yang kembali (rupiah).
  price              BigInt           @default(0)
  lineTotal          BigInt           @default(0) @map("line_total")
  value              BigInt           @default(0)

  @@index([salesReturnId])
  @@map("sales_return_line")
}

// ===== Aset dan anggaran =====

// tahap 6B: kategori aset tetap (master). Akun aset, akumulasi, dan beban dipetakan per kategori lewat account_mapping
// (aset_tetap.<id>, akumulasi_penyusutan.<id>, beban_penyusutan.<id>), KONTRAK 11.
model AssetCategory {
  id           Int          @id @default(autoincrement())
  code         String       @unique
  name         String       @unique
  usefulMonths Int          @map("useful_months")
  note         String       @default("")
  active       Boolean      @default(true)
  createdBy    Int?         @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy    Int?         @map("updated_by")
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  fixedAssets  FixedAsset[]

  @@map("asset_category")
}

model FixedAsset {
  id                   Int                 @id @default(autoincrement())
  locationId           Int?                @map("location_id")
  location             Location?           @relation(fields: [locationId], references: [id])
  assetAccountId       Int?                @map("asset_account_id")
  assetAccount         Account?            @relation("AsetAkunAset", fields: [assetAccountId], references: [id])
  accumAccountId       Int?                @map("accum_account_id")
  accumAccount         Account?            @relation("AsetAkunAkumulasi", fields: [accumAccountId], references: [id])
  expenseAccountId     Int?                @map("expense_account_id")
  expenseAccount       Account?            @relation("AsetAkunBeban", fields: [expenseAccountId], references: [id])
  directPurchaseLineId Int?                @map("direct_purchase_line_id")
  directPurchaseLine   DirectPurchaseLine? @relation(fields: [directPurchaseLineId], references: [id])
  // tahap 6B: kategori menjadi kunci asing ke asset_category (menggantikan kolom teks category).
  categoryId           Int                 @map("category_id")
  category             AssetCategory       @relation(fields: [categoryId], references: [id])
  code                 String              @unique
  name                 String
  // acquired_date juga tanggal mulai penyusutan: bulan pertama penyusutan adalah bulan tanggal ini.
  acquiredDate         DateTime            @map("acquired_date") @db.Date
  cost                 BigInt
  salvage              BigInt              @default(0)
  usefulMonths         Int                 @map("useful_months")
  method               String              @default("garis_lurus")
  bookValue            BigInt              @default(0) @map("book_value")
  // tahap 6B: akumulasi penyusutan berjalan, sumber dana perolehan (bank_account tanpa kunci asing, kosong = kas besar),
  // catatan, dan jejak aktivasi serta pembatalannya. status: draft, aktif, dilepas, batal.
  accumDepreciation    BigInt              @default(0) @map("accum_depreciation")
  bankAccountId        Int?                @map("bank_account_id")
  note                 String              @default("")
  status               String              @default("draft")
  activatedBy          Int?                @map("activated_by")
  activatedAt          DateTime?           @map("activated_at") @db.Timestamptz(6)
  cancelledBy          Int?                @map("cancelled_by")
  cancelledAt          DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  cancelReason         String?             @map("cancel_reason")
  reversalJournalId    Int?                @map("reversal_journal_id")
  createdBy            Int?                @map("created_by")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy            Int?                @map("updated_by")
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  assetDepreciations   AssetDepreciation[]
  assetDisposals       AssetDisposal[]

  @@index([categoryId])
  @@map("fixed_asset")
}

// tahap 6B: satu dokumen penyusutan per bulan untuk semua aset aktif (KONTRAK 11). Indeks unik sebagian di migrasi:
// satu dokumen Diposting per bulan.
model AssetDepreciationRun {
  id                 Int                 @id @default(autoincrement())
  no                 String              @unique
  yearMonth          String              @map("year_month") @db.VarChar(7)
  date               DateTime            @db.Date
  total              BigInt              @default(0)
  assetCount         Int                 @default(0) @map("asset_count")
  status             DocStatus           @default(Diposting)
  postedBy           Int?                @map("posted_by")
  postedAt           DateTime?           @map("posted_at") @db.Timestamptz(6)
  cancelledBy        Int?                @map("cancelled_by")
  cancelledAt        DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  cancelReason       String?             @map("cancel_reason")
  reversalJournalId  Int?                @map("reversal_journal_id")
  createdBy          Int?                @map("created_by")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  assetDepreciations AssetDepreciation[]

  @@index([yearMonth])
  @@map("asset_depreciation_run")
}

model AssetDepreciation {
  id           Int                  @id @default(autoincrement())
  fixedAssetId Int                  @map("fixed_asset_id")
  fixedAsset   FixedAsset           @relation(fields: [fixedAssetId], references: [id])
  periodId     Int                  @map("period_id")
  period       FiscalPeriod         @relation(fields: [periodId], references: [id])
  // tahap 6B: dokumen penyusutan bulanannya dan akumulasi aset sesudah baris ini.
  runId        Int                  @map("run_id")
  run          AssetDepreciationRun @relation(fields: [runId], references: [id])
  accumAfter   BigInt               @default(0) @map("accum_after")
  amount       BigInt
  kind         String               @default("komersial")
  postedBy     Int?                 @map("posted_by")
  postedAt     DateTime             @default(now()) @map("posted_at") @db.Timestamptz(6)

  @@unique([runId, fixedAssetId])
  @@index([fixedAssetId])
  @@map("asset_depreciation")
}

model AssetDisposal {
  id                Int        @id @default(autoincrement())
  fixedAssetId      Int        @map("fixed_asset_id")
  fixedAsset        FixedAsset @relation(fields: [fixedAssetId], references: [id])
  cashAccountId     Int?       @map("cash_account_id")
  cashAccount       Account?   @relation("LepasAsetAkunKas", fields: [cashAccountId], references: [id])
  // tahap 6B: tujuan uang hasil penjualan (bank_account tanpa kunci asing, kosong = kas besar), dan salinan nilai aset
  // saat diposting.
  bankAccountId     Int?       @map("bank_account_id")
  cost              BigInt     @default(0)
  accumDepreciation BigInt     @default(0) @map("accum_depreciation")
  bookValue         BigInt     @default(0) @map("book_value")
  no                String     @unique
  date              DateTime   @db.Date
  proceeds          BigInt     @default(0)
  gainLoss          BigInt     @default(0) @map("gain_loss")
  note              String     @default("")
  status            DocStatus  @default(Draft)
  submittedBy       Int?       @map("submitted_by")
  submittedAt       DateTime?  @map("submitted_at") @db.Timestamptz(6)
  approvedBy        Int?       @map("approved_by")
  approvedAt        DateTime?  @map("approved_at") @db.Timestamptz(6)
  cancelledBy       Int?       @map("cancelled_by")
  cancelledAt       DateTime?  @map("cancelled_at") @db.Timestamptz(6)
  cancelReason      String?    @map("cancel_reason")
  postedBy          Int?       @map("posted_by")
  postedAt          DateTime?  @map("posted_at") @db.Timestamptz(6)
  reversalJournalId Int?       @map("reversal_journal_id")
  createdBy         Int?       @map("created_by")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy         Int?       @map("updated_by")
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([fixedAssetId])
  @@map("asset_disposal")
}

model Budget {
  id            Int          @id @default(autoincrement())
  // tahap 6B: nomor AG-YYMM-NNNN, versi revisi, anggaran asal revisi, dan tanda sudah digantikan revisi yang disetujui.
  no            String       @unique
  version       Int          @default(1)
  revisedFromId Int?         @map("revised_from_id")
  revisedFrom   Budget?      @relation("RevisiAnggaran", fields: [revisedFromId], references: [id])
  revisions     Budget[]     @relation("RevisiAnggaran")
  replacedBy    Int?         @map("replaced_by")
  replacedAt    DateTime?    @map("replaced_at") @db.Timestamptz(6)
  note          String       @default("")
  name          String
  year          Int
  status        DocStatus    @default(Draft)
  submittedBy   Int?         @map("submitted_by")
  submittedAt   DateTime?    @map("submitted_at") @db.Timestamptz(6)
  approvedBy    Int?         @map("approved_by")
  approvedAt    DateTime?    @map("approved_at") @db.Timestamptz(6)
  cancelledBy   Int?         @map("cancelled_by")
  cancelledAt   DateTime?    @map("cancelled_at") @db.Timestamptz(6)
  cancelReason  String?      @map("cancel_reason")
  closeReason   String?      @map("close_reason")
  closedAt      DateTime?    @map("closed_at") @db.Timestamptz(6)
  createdBy     Int?         @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy     Int?         @map("updated_by")
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  budgetLines   BudgetLine[]

  @@index([year])
  @@map("budget")
}

model BudgetLine {
  id        Int     @id @default(autoincrement())
  budgetId  Int     @map("budget_id")
  budget    Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountId Int     @map("account_id")
  account   Account @relation(fields: [accountId], references: [id])
  month     Int
  amount    BigInt
  note      String  @default("")

  @@unique([budgetId, accountId, month])
  @@index([budgetId])
  @@map("budget_line")
}
