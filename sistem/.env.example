# Salin ke .env lalu isi nilainya. Jangan commit .env.
# Basis data dev dan alamat server untuk basis data uji (tes membuat greenbox_uji_<acak> sendiri).
DATABASE_URL=postgresql://greenbox:ISI_SANDI@127.0.0.1:55441/greenbox
TEST_DATABASE_URL=postgresql://greenbox:ISI_SANDI@127.0.0.1:55441/greenbox_uji
# Rahasia penanda tangan sesi, minimal 32 karakter acak (misalnya: openssl rand -hex 32).
SESSION_SECRET=
# Jumlah koneksi Prisma paling banyak. Bawaan 3.
DB_POOL_MAX=3
# 1 bila app di belakang proxy balik yang mengisi X-Forwarded-For atau X-Real-IP.
TRUST_PROXY=0
# 1 di produksi (HTTPS): cookie Secure, HSTS, upgrade-insecure-requests. Kosong berarti ikut NODE_ENV=production.
HTTPS_AKTIF=0
# Owner pertama untuk prisma db seed. Hanya dipakai bila belum ada Owner.
SEED_OWNER_USERNAME=
SEED_OWNER_NAME=
SEED_OWNER_PASSWORD=
# Admin dan Kasir contoh untuk npm run seed:contoh (lokal dan uji saja).
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_KASIR_USERNAME=
SEED_KASIR_PASSWORD=
# Superadmin dan Finance contoh untuk seed:contoh (dilewati bila kosong) dan uji klik e2e.
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PASSWORD=
SEED_FINANCE_USERNAME=
SEED_FINANCE_PASSWORD=
# npm run akun:awal (boleh di produksi) memakai SEED_<PERAN>_USERNAME, SEED_<PERAN>_PASSWORD, dan SEED_<PERAN>_NAME untuk
# OWNER, SUPERADMIN, ADMIN, KASIR, dan FINANCE. Peran yang nama penggunanya kosong dilewati.
